# ==============================================================================
# SHRAMA SATHI AI - Sovereign Worker Intelligence Environment Configuration
# ==============================================================================

# Database Configuration (Prisma ORM with SQLite file or Postgres)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# PRIMARY VOICE ENGINE: Gnani.ai Timbre Text-to-Speech (TTS)
# ------------------------------------------------------------------------------
# Enter your Gnani AI Timbre API key below
TIMBRE_API_KEY=""
TIMBRE_API_URL="https://api.gnani.ai/v1/timbre/synthesize"
TIMBRE_DEFAULT_VOICE="timbre-hi-female-1"

# ------------------------------------------------------------------------------
# PRIMARY REASONING ENGINE: Gnani.ai Evon LLM
# ------------------------------------------------------------------------------
# Enter your Gnani AI Evon API key below
EVON_API_KEY=""
EVON_API_URL="https://api.gnani.ai/v1/evon/chat/completions"
EVON_MODEL="evon-v3.3"

# ------------------------------------------------------------------------------
# ALTERNATIVE AI PROVIDER 1: Google Gemini API (Recommended Fast Alternative)
# ------------------------------------------------------------------------------
# If you don't have an Evon key, insert a Gemini API key here (supports all Indian languages)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# ALTERNATIVE AI PROVIDER 2: OpenAI / Groq / OpenRouter Compatible API
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="SHRAMA SATHI AI"
