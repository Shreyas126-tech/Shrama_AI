# Database configuration (Prisma ORM)
DATABASE_URL="file:./dev.db"

# Gnani AI - Evon LLM Configuration
# Server-side only credentials
EVON_API_KEY=""
EVON_API_URL="https://api.gnani.ai/v1/evon/chat/completions"
EVON_MODEL="evon-v3.3"

# Gnani AI - Timbre Text-to-Speech (TTS) Configuration
