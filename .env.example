# ==============================================================================
# SHRAMA SATHI AI - Sovereign Worker Intelligence Environment Configuration
# ==============================================================================

# Database Configuration (Prisma ORM with SQLite file or Postgres)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# PRIMARY VOICE ENGINE: Gnani.ai / Vachana Timbre v3.0 Text-to-Speech (TTS)
# ------------------------------------------------------------------------------
TIMBRE_API_KEY="vach_..."
TIMBRE_API_URL="https://api.vachana.ai/api/v1/tts/inference"
TIMBRE_DEFAULT_VOICE="Shivani"
TIMBRE_MODEL="timbre-v3.0"

# ------------------------------------------------------------------------------
# PRIMARY REASONING ENGINE: Gnani.ai Evon LLM
# ------------------------------------------------------------------------------
EVON_API_KEY=""
EVON_API_URL="https://api.gnani.ai/v1/evon/chat/completions"
EVON_MODEL="evon-v3.3"

# ------------------------------------------------------------------------------
# ALTERNATIVE AI PROVIDER 1: Google Gemini API (Recommended Fast Alternative)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# ALTERNATIVE AI PROVIDER 2: OpenAI / Groq / OpenRouter Compatible API
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="SHRAMA SATHI AI"
